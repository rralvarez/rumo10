<?xml version="1.0" encoding="UTF-8"?>
<configuration><system.webServer><directoryBrowse enabled="false"/><rewrite><rules><rule name="Repository must not be public" stopProcessing="true"><match url=".*"/><action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Configure document root to public"/></rule></rules></rewrite></system.webServer></configuration>
